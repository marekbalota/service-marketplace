@startuml Marketplace for services

!pragma ratio 0.8

hide circle

skinparam linetype ortho
skinparam classSpacing 60
skinparam classArrowFontSize 12
skinparam classArrowThickness 1.5
skinparam classArrowColor black

skinparam class {
    BackgroundColor #ADD8E6
    BorderColor black
    ArrowColor black
}

entity User {
    id : uuid <<PK>>
    ---
    role_id : uuid <<FK>>
    name : text <<NOT NULL>>
    email : text <<NOT NULL>> <<UNIQUE>>
    email_verified : boolean <<NOT NULL>>
    image : text
    created_at : timestamp <<NOT NULL>>
    updated_at : timestamp <<NOT NULL>>
}

entity Session {
    id : uuid <<PK>>
    ---
    user_id : uuid <<FK>> <<NOT NULL>>
    expires_at : timestamp <<NOT NULL>>
    token : text <<NOT NULL>> <<UNIQUE>>
    ip_address : text
    user_agent : text
    created_at : timestamp <<NOT NULL>>
    updated_at : timestamp <<NOT NULL>>
}

entity OAuthAccount {
    id : uuid <<PK>>
    ---
    user_id : uuid <<FK>> <<NOT NULL>>
    account_id : text <<NOT NULL>>
    provider_id : text <<NOT NULL>>
    access_token : text
    refresh_token : text
    id_token : text
    access_token_expires_at : timestamp
    refresh_token_expires_at : timestamp
    scope : text
    password : text
    created_at : timestamp <<NOT NULL>>
    updated_at : timestamp <<NOT NULL>>
}

entity Verification {
    id : uuid <<PK>>
    ---
    identifier : text <<NOT NULL>>
    value : text <<NOT NULL>>
    expires_at : timestamp <<NOT NULL>>
    created_at : timestamp
    updated_at : timestamp
}

entity Role {
    role_id : uuid <<PK>>
    ---
    name : text <<NOT NULL>> <<UNIQUE>>
    description : text
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity Permission {
    permission_id : uuid <<PK>>
    ---
    name : text <<NOT NULL>> <<UNIQUE>>
    description : text
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity RolePermission {
    role_id : uuid <<PK>> <<FK>>
    permission_id : uuid <<PK>> <<FK>>
    ---
    deleted_at : timestamp
}

entity UserProfile {
    user_profile_id : uuid <<PK>>
    ---
    account_id : uuid <<FK>> <<NOT NULL>>
    name : text <<NOT NULL>>
    email : text <<NOT NULL>>
    bio : text
    phone_number : text
    fax : text
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity Review {
    review_id : uuid <<PK>>
    ---
    reviewer_id : uuid <<FK>> <<NOT NULL>>
    post_id : uuid <<FK>> <<NOT NULL>>
    rating : int <<NOT NULL>> CHECK (rating BETWEEN 1 AND 5)
    review_description : text
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity Post {
    post_id : uuid <<PK>>
    ---
    author_id : uuid <<FK>> <<NOT NULL>>
    location_id : uuid <<FK>>
    post_title : text <<NOT NULL>>
    description : text <<NOT NULL>>
    post_type : enum('REQUEST', 'OFFER') <<NOT NULL>>
    price : numeric(10,2)
    rate_type : enum('HOURLY', 'DAILY', 'FIXED')
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity Message {
    message_id : uuid <<PK>>
    ---
    sender_id : uuid <<FK>> <<NOT NULL>>
    thread_id : uuid <<FK>> <<NOT NULL>>
    content : text <<NOT NULL>>
    read_at : timestamp
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity Report {
    report_id : uuid <<PK>>
    ---
    reporter_id : uuid <<FK>> <<NOT NULL>>
    post_id : uuid <<FK>> <<NOT NULL>>
    description : text <<NOT NULL>>
    reason : text <<NOT NULL>>
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity Category {
    category_id : uuid <<PK>>
    ---
    name : text <<NOT NULL>> <<UNIQUE>>
    description : text
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity PostCategory {
    post_id : uuid <<PK>> <<FK>>
    category_id : uuid <<PK>> <<FK>>
}

entity Location {
    location_id : uuid <<PK>>
    ---
    country : text
    region : text
    city : text
    street : text
    house_number : text
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity Image {
    image_id : uuid <<PK>>
    ---
    user_profile_id : uuid <<FK>> <<NOT NULL>>
    name : text <<NOT NULL>>
    link : text <<NOT NULL>>
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity Favourites {
    user_profile_id : uuid <<PK>> <<FK>>
    post_id : uuid <<PK>> <<FK>>
    ---
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

entity MessageThread {
    thread_id : uuid <<PK>>
    ---
    post_id : uuid <<FK>> <<NOT NULL>>
    initiator_id : uuid <<FK>> <<NOT NULL>>
    created_at : timestamp <<NOT NULL>>
    deleted_at : timestamp
}

Post }o--|| UserProfile : creates
Post ||--o{ PostCategory
Category ||--o{ PostCategory
Role ||--o{ RolePermission
Permission ||--o{ RolePermission
Review }o--|| UserProfile : reviewer
Review }o--|| Post : reviewed post
Message }o--|| UserProfile : sender
Message }o--|| MessageThread : belongs to
MessageThread }o--|| Post
MessageThread }o--|| UserProfile : initiator
Post ||--o{ Report : reported
User ||--o{ UserProfile
User }o--|| Role
User ||--o{ Session
User ||--o{ OAuthAccount
UserProfile ||--o{ Image
UserProfile ||--o{ Favourites
Post ||--o{ Favourites
UserProfile ||--o{ Report : reports
Post }o--o| Location

@enduml