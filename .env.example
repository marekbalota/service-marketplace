# Database — used by docker-compose for container setup; DATABASE_URL must match
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketplace
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace

# Backend
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO — used by docker-compose for container setup; values must match MINIO_* vars below
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=marketplace
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_USE_SSL=false

# Frontend
VITE_API_URL=http://localhost:3001

# Geoapify — address autocomplete with Czech/Slovak language support
# Register for free at https://myprojects.geoapify.com — free tier: 3000 req/day
GEOAPIFY_API_KEY=your-geoapify-api-key

# Cloudflare Turnstile CAPTCHA
# Dev/test: use the always-pass test keys below (no Cloudflare account needed)
# Production: register at cloudflare.com/turnstile and replace with real keys
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
