{
  "name": "api",
  "version": "1.0.50",
  "scripts": {
    "test": "NODE_ENV=test bun --env-file=../../.env test",
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env run drizzle-kit studio",
    "db:seed": "bun --env-file=../../.env run src/db/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@marketplace/shared": "workspace:*",
    "better-auth": "^1.6.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "ioredis": "^5.10.1",
    "minio": "^8.0.7",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
