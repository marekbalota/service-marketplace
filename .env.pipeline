# CI Pipeline — Docker Compose tests (hostnames use Docker DNS: db, api, web)

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketplace_ci
DATABASE_URL=postgresql://postgres:postgres@db:5432/marketplace_ci

# Backend
NODE_ENV=test
BETTER_AUTH_URL=http://api:3001
BETTER_AUTH_SECRET=test-secret-do-not-use-in-production
FRONTEND_URL=http://web:3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=marketplace
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_USE_SSL=false

# Cloudflare Turnstile (test keys that always pass)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Frontend (Vite build-time vars — injected via env_file into web container)
VITE_API_URL=http://api:3001
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA